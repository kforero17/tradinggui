# TradingGui Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================================================
# Flask Configuration
# ============================================================================

# Flask Secret Key (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-generate-with-secrets.token_hex(32)

# Flask Environment
FLASK_ENV=development

# Debug Mode (set to false for production)
WEB_APP_DEBUG=false

# ============================================================================
# SSL Configuration (Corporate Proxy/VPN)
# ============================================================================

# WARNING: Only set to 'true' in corporate environments with trusted proxies
# Setting to 'true' disables SSL verification which allows MITM attacks
# This is a SECURITY RISK - only use behind validated corporate proxies
DISABLE_SSL_VERIFY=false

# ============================================================================
# Authentication (Optional - leave empty to disable)
# ============================================================================

# Enable basic authentication
AUTH_ENABLED=false

# Username for basic auth
FLASK_AUTH_USERNAME=

# Password hash for basic auth
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
FLASK_AUTH_PASSWORD_HASH=

# ============================================================================
# Security Features
# ============================================================================

# Enable CSRF protection (recommended: true)
CSRF_ENABLED=true

# Enable rate limiting (recommended: true)
RATE_LIMIT_ENABLED=true

# Default rate limit for all endpoints
RATE_LIMIT_DEFAULT=100 per hour

# Rate limit for API endpoints (stricter)
RATE_LIMIT_API_ENDPOINTS=10 per minute

# ============================================================================
# Database Configuration
# ============================================================================

# Database path (relative to project root)
# DB_PATH=data/processed/stock_metrics.db

# ============================================================================
# Application Settings
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Web app host and port
# WEB_APP_HOST=127.0.0.1
# WEB_APP_PORT=8051
